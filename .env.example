# Copy to .env. Use a URL-safe database password (letters/numbers/dashes).
POSTGRES_PASSWORD=replace-with-a-long-random-password
# One workspace for v1. Do not expose the development token on the Internet.
BIDDY_ACCESS_TOKEN=replace-with-a-long-random-workspace-token
BIDDY_WORKSPACE_ID=primary-workspace
DATABASE_URL=sqlite:///./biddy.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,https://biddy-bid-copilot.garvjhajharia6.chatgpt.site

# Start with rules for a no-cost deterministic pipeline check.
# Paid modes: openai, openai-compatible, anthropic, gemini.
LLM_PROVIDER=rules
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_CONCURRENCY=3
# Optional current rates for cost estimates. No prices are assumed.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=900

# Examples (set one provider, its matching key, and an available model):
# LLM_PROVIDER=openai; LLM_MODEL=gpt-4.1-mini
# LLM_PROVIDER=anthropic; LLM_MODEL=claude-sonnet-4-5
# LLM_PROVIDER=gemini; LLM_MODEL=gemini-2.5-flash
# LLM_PROVIDER=openai-compatible; LLM_BASE_URL=https://your-provider.example/v1
# Compatible endpoints must support response_format.json_schema.
